# Project Settings → API (https://supabase.com/dashboard/project/_/settings/api)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Postgres URI for local psql/migrations only (never commit real values)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# OpenImpact contract (Sepolia). Leave unset to keep donate/confirm as stubs.
# VITE_OPENIMPACT_CONTRACT_ADDRESS=0xYourDeployedOpenImpact
# VITE_CHAIN_ID=11155111
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
